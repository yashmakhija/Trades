DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trading_app?schema=public"


PORT=3001
NODE_ENV=development


BINANCE_WEBSOCKET_URL=wss://stream.binance.com:9443/ws
TRADING_SYMBOLS=btcusdt,ethusdt,bnbusdt,solusdt,adausdt

# JWT Settings
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRES_IN=7d

# Optional API keys (if needed for private endpoints)
BINANCE_API_KEY=your-api-key
BINANCE_API_SECRET=your-api-secret

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Prisma Configuration
PRISMA_CLIENT_ENGINE_TYPE=binary

# Database Seeding
SEED_DATABASE=true 