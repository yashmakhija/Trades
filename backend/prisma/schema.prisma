// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // Use this setting for better compatibility with TimescaleDB
  previewFeatures = ["nativeTypes"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  name        String?
  usdcBalance Int      @default(1000000)
  orders      Order[]
  balanceHistory BalanceHistory[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Symbol {
  id           String   @id @default(uuid())
  name         String   @unique
  description  String?
  currentPrice Int?
  orders       Order[]
  ohlcv        OHLCV[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Order {
  id            String      @id @default(uuid())
  symbolId      String
  symbol        Symbol      @relation(fields: [symbolId], references: [id])
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  stopLoss      Int?
  takeProfit    Int?
  price         Int         // Entry price
  quantity      Int         // Always fully filled in our case
  exitPrice     Int?        // Price when closed
  pnl           Int?        // Realized profit/loss
  status        OrderStatus @default(CLOSED)
  type          OrderType
  isShort       Boolean     @default(false)
  parentOrderId String?     // For linked orders (stop loss/take profit)
  parentOrder   Order?      @relation("LinkedOrders", fields: [parentOrderId], references: [id])
  childOrders   Order[]     @relation("LinkedOrders")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  closedAt      DateTime?   // When the order was closed
  reservedAmount Int?      // Amount reserved for this order (stored as integer)
  balanceHistory BalanceHistory[]

  @@index([userId])
  @@index([symbolId])
  @@index([status])
}

// Enhanced OHLCV model optimized for TimescaleDB
model OHLCV {
  id        String     @default(uuid())
  symbolId  String
  symbol    Symbol     @relation(fields: [symbolId], references: [id])
  open      Int
  high      Int
  low       Int
  close     Int
  volume    Int
  timeframe Timeframe  @default(ONE_MINUTE)
  time      DateTime   @default(now())

  // Composite primary key including time for TimescaleDB compatibility
  @@id([id, time])
  
  // Compound index for efficient time-series queries
  @@index([symbolId, timeframe, time(sort: Desc)])
  // Index for range queries on time
  @@index([time(sort: Desc)])
  // Index for filtering by symbol
  @@index([symbolId])
  // Index for filtering by timeframe
  @@index([timeframe])
}

model BalanceHistory {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  amount      Int             // Amount stored as integer (100 USDC = 10000)
  type        BalanceType     // Using enum for transaction types
  description String
  orderId     String?
  order       Order?          @relation(fields: [orderId], references: [id])
  createdAt   DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([orderId])
}

enum OrderType {
  BUY
  SELL
}

enum OrderStatus {
  PENDING
  OPEN
  FILLED
  CLOSED
  CANCELLED
}

// Timeframe enum for different candle periods
enum Timeframe {
  ONE_MINUTE
  FIVE_MINUTES
  TEN_MINUTES
  FIFTEEN_MINUTES
  THIRTY_MINUTES
  ONE_HOUR
  FOUR_HOURS
  ONE_DAY
}

enum BalanceType {
  DEPOSIT      // Initial or additional deposits
  WITHDRAWAL   // User withdrawals
  TRADE_OPEN   // Balance reserved for new trade
  TRADE_CLOSE  // Balance released/updated when trade closes
  TRADE_CANCEL // Balance released when order is cancelled
  FUNDING      // Funding payments (for futures)
  REFERRAL     // Referral rewards
  ADJUSTMENT   // Manual/system adjustments
}

